<!--
  TFM-Conditional Version Governance for Framework-Coupled Packages
  =================================================================
  Framework-coupled packages (Microsoft.Extensions.*, AspNetCore.*, EF Core, Npgsql, Pomelo)
  must match the consumer's target framework to avoid diamond dependency conflicts.

  How it works:
  - Default values (below) apply when no TFM-specific override matches.
  - When a consumer targets net8.0, the net8.0 PropertyGroup overrides with 8.0.x versions,
    matching the .NET 8 shared runtime and preventing transitive version conflicts.

  Extending for future TFMs:
  - net9.0: Add <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'"> with 9.x versions
  - net10.0: Add <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'"> with 10.x versions
-->
<Project>

  <!-- net9.0: Override to pin framework-coupled packages to 9.0.x for .NET 9 shared runtime compatibility -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <!-- Microsoft.Extensions.* core packages -->
    <MicrosoftExtensionsVersion>9.0.4</MicrosoftExtensionsVersion>
    <!-- Microsoft.Extensions.Caching.* packages -->
    <MicrosoftExtensionsCachingVersion>9.0.4</MicrosoftExtensionsCachingVersion>
    <!-- Microsoft.Extensions.Http (non-resilience) -->
    <MicrosoftExtensionsHttpVersion>9.0.4</MicrosoftExtensionsHttpVersion>
    <!-- Microsoft.Extensions.Http.Polly -->
    <MicrosoftExtensionsHttpPollyVersion>8.0.10</MicrosoftExtensionsHttpPollyVersion>
    <!-- Microsoft.Extensions.Http.Resilience -->
    <MicrosoftExtensionsHttpResilienceVersion>8.10.1</MicrosoftExtensionsHttpResilienceVersion>
    <!-- Microsoft.EntityFrameworkCore.* (main packages) -->
    <EfCoreVersion>9.0.4</EfCoreVersion>
    <!-- Microsoft.EntityFrameworkCore.Design (versioned separately) -->
    <EfCoreDesignVersion>9.0.4</EfCoreDesignVersion>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL -->
    <NpgsqlEfCoreVersion>9.0.4</NpgsqlEfCoreVersion>
    <!-- Pomelo.EntityFrameworkCore.MySql -->
    <PomeloMySqlVersion>9.0.0-preview.1.1</PomeloMySqlVersion>
    <!-- Microsoft.AspNetCore.* packages -->
    <AspNetCoreVersion>9.0.4</AspNetCoreVersion>
    <!-- Microsoft.AspNetCore.SignalR.Client -->
    <AspNetCoreSignalRVersion>9.0.4</AspNetCoreSignalRVersion>
    <!-- Microsoft.AspNetCore.TestHost -->
    <AspNetCoreTestHostVersion>9.0.4</AspNetCoreTestHostVersion>
  </PropertyGroup>

  <!-- Default values: used when no TFM-specific condition matches (net9.0, net472, netstandard2.0, etc.) -->
  <PropertyGroup>
    <!-- Microsoft.Extensions.* core packages -->
    <MicrosoftExtensionsVersion>10.0.3</MicrosoftExtensionsVersion>
    <!-- Microsoft.Extensions.Caching.* packages -->
    <MicrosoftExtensionsCachingVersion>10.0.3</MicrosoftExtensionsCachingVersion>
    <!-- Microsoft.Extensions.Http (non-resilience) -->
    <MicrosoftExtensionsHttpVersion>10.0.3</MicrosoftExtensionsHttpVersion>
    <!-- Microsoft.Extensions.Http.Polly -->
    <MicrosoftExtensionsHttpPollyVersion>8.0.10</MicrosoftExtensionsHttpPollyVersion>
    <!-- Microsoft.Extensions.Http.Resilience -->
    <MicrosoftExtensionsHttpResilienceVersion>8.1.0</MicrosoftExtensionsHttpResilienceVersion>
    <!-- Microsoft.EntityFrameworkCore.* (main packages) -->
    <EfCoreVersion>8.0.24</EfCoreVersion>
    <!-- Microsoft.EntityFrameworkCore.Design (versioned separately) -->
    <EfCoreDesignVersion>8.0.11</EfCoreDesignVersion>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL -->
    <NpgsqlEfCoreVersion>8.0.11</NpgsqlEfCoreVersion>
    <!-- Pomelo.EntityFrameworkCore.MySql -->
    <PomeloMySqlVersion>8.0.2</PomeloMySqlVersion>
    <!-- Microsoft.AspNetCore.* packages -->
    <AspNetCoreVersion>8.0.15</AspNetCoreVersion>
    <!-- Microsoft.AspNetCore.SignalR.Client -->
    <AspNetCoreSignalRVersion>8.0.1</AspNetCoreSignalRVersion>
    <!-- Microsoft.AspNetCore.TestHost -->
    <AspNetCoreTestHostVersion>8.0.11</AspNetCoreTestHostVersion>
  </PropertyGroup>

  <!-- net8.0: Override to pin framework-coupled packages to 8.0.x for .NET 8 shared runtime compatibility -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Microsoft.Extensions.* core packages -->
    <MicrosoftExtensionsVersion>8.0.5</MicrosoftExtensionsVersion>
    <!-- Microsoft.Extensions.Caching.* packages -->
    <MicrosoftExtensionsCachingVersion>8.0.5</MicrosoftExtensionsCachingVersion>
    <!-- Microsoft.Extensions.Http (non-resilience) -->
    <MicrosoftExtensionsHttpVersion>8.0.5</MicrosoftExtensionsHttpVersion>
    <!-- Microsoft.Extensions.Http.Polly -->
    <MicrosoftExtensionsHttpPollyVersion>8.0.10</MicrosoftExtensionsHttpPollyVersion>
    <!-- Microsoft.Extensions.Http.Resilience -->
    <MicrosoftExtensionsHttpResilienceVersion>8.1.0</MicrosoftExtensionsHttpResilienceVersion>
    <!-- Microsoft.EntityFrameworkCore.* (main packages) -->
    <EfCoreVersion>8.0.24</EfCoreVersion>
    <!-- Microsoft.EntityFrameworkCore.Design (versioned separately) -->
    <EfCoreDesignVersion>8.0.11</EfCoreDesignVersion>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL -->
    <NpgsqlEfCoreVersion>8.0.11</NpgsqlEfCoreVersion>
    <!-- Pomelo.EntityFrameworkCore.MySql -->
    <PomeloMySqlVersion>8.0.2</PomeloMySqlVersion>
    <!-- Microsoft.AspNetCore.* packages -->
    <AspNetCoreVersion>8.0.15</AspNetCoreVersion>
    <!-- Microsoft.AspNetCore.SignalR.Client -->
    <AspNetCoreSignalRVersion>8.0.1</AspNetCoreSignalRVersion>
    <!-- Microsoft.AspNetCore.TestHost -->
    <AspNetCoreTestHostVersion>8.0.11</AspNetCoreTestHostVersion>
  </PropertyGroup>

</Project>
