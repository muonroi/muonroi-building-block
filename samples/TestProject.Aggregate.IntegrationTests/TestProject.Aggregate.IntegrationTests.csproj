<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsMuonroiTestProject>true</IsMuonroiTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- gRPC client stubs for shared AggregateRpc service (GrpcServices=Client) -->
    <Protobuf Include="..\TestProject.Aggregate\src\TestProject.Aggregate.Host\v1\Protos\service.proto"
              GrpcServices="Client"
              AdditionalImportDirs="..\TestProject.Aggregate\v1\Protos\" />
    <!-- shared.proto needed for SharedContainerInfo message (no code gen, just import resolution) -->
    <Protobuf Include="..\TestProject.Aggregate\v1\Protos\shared.proto"
              GrpcServices="None" />
    <!-- gRPC client stubs for per-site Bravo BravoAggregateRpc service (GrpcServices=Client) -->
    <Protobuf Include="..\TestProject.Aggregate\src\TestProject.Aggregate.Sites.Bravo\Protos\service.bravo.proto"
              GrpcServices="Client"
              AdditionalImportDirs="..\TestProject.Aggregate\v1\Protos\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestProject.Aggregate\src\TestProject.Aggregate.Host\TestProject.Aggregate.Host.csproj" />
    <ProjectReference Include="..\TestProject.Aggregate\src\TestProject.Aggregate.Sites.Default\TestProject.Aggregate.Sites.Default.csproj" />
    <ProjectReference Include="..\TestProject.Aggregate\src\TestProject.Aggregate.Sites.Alpha\TestProject.Aggregate.Sites.Alpha.csproj" />
    <ProjectReference Include="..\TestProject.Aggregate\src\TestProject.Aggregate.Sites.Bravo\TestProject.Aggregate.Sites.Bravo.csproj" />
    <ProjectReference Include="..\TestProject.Aggregate\src\TestProject.Aggregate.Core\TestProject.Aggregate.Core.csproj" />
    <ProjectReference Include="..\..\src\Muonroi.Tenancy.SiteProfile.Grpc\Muonroi.Tenancy.SiteProfile.Grpc.csproj" />
    <ProjectReference Include="..\..\src\Muonroi.Tenancy.SiteProfile.Web\Muonroi.Tenancy.SiteProfile.Web.csproj" />
    <ProjectReference Include="..\..\src\Muonroi.Logging\Muonroi.Logging.csproj" />
  </ItemGroup>
</Project>
