{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Multi-level cache configuration — read by CacheConfigs and AddMultiLevelCaching().
  "CacheConfigs": {
    // CacheType: Memory | Redis | MultiLevel
    // Memory  = in-process IMemoryCache only (no external dependency)
    // Redis   = distributed Redis only (requires Redis section below)
    // MultiLevel = memory + distributed (falls through to memory on miss)
    "CacheType": "Memory",
    "KeyNamespace": "quickstart",
    "EnableStampedeProtection": true,
    "DefaultAbsoluteExpirationInMinutes": 60,
    // TtlJitterPercent: adds random ±N% jitter to TTLs to prevent thundering-herd expiry
    "TtlJitterPercent": 10
  },
  // Redis section — only used when CacheType is Redis or MultiLevel
  "Redis": {
    "Enable": false,
    "Host": "localhost",
    "Port": 6379
  }
}
