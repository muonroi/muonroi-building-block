{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Information"
    }
  },
  "AllowedHosts": "*",

  // ---------------------------------------------------------------------------
  // MessageBus — top-level flag consumed directly by Program.cs
  // ---------------------------------------------------------------------------
  "MessageBus": {
    // Set to true to use the full Muonroi AddMessageBus() stack (RabbitMQ).
    // Requires a running broker and a valid Muonroi premium licence.
    // false (default) uses the in-memory MassTransit transport — no broker needed.
    "UseRabbitMq": false
  },

  // ---------------------------------------------------------------------------
  // MessageBusConfigs — read by AddMessageBus() when UseRabbitMq = true.
  // The section name must match MessageBusConfigs.SectionName ("MessageBusConfigs").
  // ---------------------------------------------------------------------------
  "MessageBusConfigs": {
    "BusType": "RabbitMq",

    "RabbitMq": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest",
      "Port": 5672,
      "UseSsl": false,
      "HeartbeatSeconds": 30,
      "PublisherConfirmation": true,
      "UseQuorumQueues": false
    },

    "Runtime": {
      "EndpointPrefix": "quickstart-messaging",
      "RetryCount": 3,
      "RetryIntervalMs": 500,
      "PrefetchCount": 32,
      "ConcurrentMessageLimit": 16,
      "EnableInMemoryOutbox": true
    },

    "OutboxRelay": {
      "Enabled": false,
      "PollingIntervalMs": 5000,
      "BatchSize": 100,
      "MaxRetryFailedCount": 5
    },

    "MaskAccessTokenInHeaders": false,
    "EnableQuotaEnforcement": false,
    "EnableRuleEngineRouting": false,
    "EnableRedisRoutingTable": false
  }
}
