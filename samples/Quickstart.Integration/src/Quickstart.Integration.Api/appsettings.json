{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Connector configuration — values are read by ConnectorController and passed
  // into ConnectorContext.Config / ConnectorContext.Credentials at runtime.
  // Replace placeholder values with real credentials before running.
  "Connectors": {
    // HTTP connector — used by POST /api/connectors/http/execute
    "Http": {
      "DefaultUrl": "https://jsonplaceholder.typicode.com/todos/1",
      "DefaultMethod": "GET",
      "TimeoutSeconds": 30
    },

    // Slack webhook connector — used by POST /api/connectors/slack/webhook
    // Set Enable=true and provide a real Incoming Webhook URL to test.
    "Slack": {
      "Enable": false,
      "WebhookUrl": "https://hooks.slack.com/services/REPLACE/WITH/REAL_URL",
      "DefaultChannel": "#general"
    },

    // GitHub connector (custom) — used by POST /api/connectors/github/execute
    // Set Enable=true and supply a Personal Access Token (read:user scope is sufficient).
    "GitHub": {
      "Enable": false,
      "Token": "ghp_REPLACE_WITH_REAL_TOKEN",
      "Owner": "muonroi",
      "Repo": "muonroi-building-block"
    }
  }
}
