{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Connection string consumed by AddMRuleEngineWithPostgres() to configure
  // RuleEngineDbContext (Npgsql). No connection is opened until a store
  // operation runs, so the app starts without a live database.
  "ConnectionStrings": {
    "RuleDb": "Host=localhost;Port=5432;Database=muonroi_rules;Username=admin;Password=admin"
  },
  // Control-plane options bound by RuleControlPlaneOptions.
  "RuleControlPlane": {
    "RequireApproval": false,
    "EnableCanary": true
  },
  // Multi-tenant / row-level-security options read by the EF Core registration.
  // EnableRowLevelSecurity=false keeps the sample single-tenant.
  "MultiTenant": {
    "EnableRowLevelSecurity": false
  }
}
