{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // RuleStore section — bound by AddRuleEngineStore() into RuleStoreConfigs.
  "RuleStore": {
    // Folder where ruleset artifacts are stored (resolved against the content root).
    "RootPath": "rulesets",
    "UseContentRoot": true,
    "EnableRuntimeCache": true,
    "RuntimeCacheMinutes": 10,
    "RuleChangeChannel": "muonroi:ruleset:changed"
  }
}
