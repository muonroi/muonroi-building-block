{
  // ─── BackgroundJobConfigs ────────────────────────────────────────────────────
  // BackgroundJobHandler.AddBackgroundJobs() reads this section.
  //
  // JobType:
  //   "Hangfire" → uses Muonroi.BackgroundJobs.Hangfire (registered by its [ModuleInitializer])
  //   "Quartz"   → uses Muonroi.BackgroundJobs.Quartz  (registered by its [ModuleInitializer])
  //
  // ConnectionString:
  //   null / omitted → Hangfire will use the MemoryStorage configured in Program.cs.
  //   Provide a SQL Server / PostgreSQL / Redis connection string for production.
  "BackgroundJobConfigs": {
    "JobType": "Hangfire",
    "ConnectionString": null
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
}
