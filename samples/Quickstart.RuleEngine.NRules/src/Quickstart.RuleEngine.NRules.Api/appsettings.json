{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // RuleOptions bound by AddNRulesEngine(). Each key is a [Rule(name, ...)]
  // name; set Enabled=false to drop a rule, or Version to pin a version.
  "NRules": {
    "Rules": {
      "HighValueOrderDiscount": {
        "Enabled": true,
        "Version": "1.0"
      }
    }
  }
}
