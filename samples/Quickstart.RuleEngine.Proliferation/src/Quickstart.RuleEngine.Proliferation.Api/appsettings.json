{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Postgres connection consumed by AddMProliferationPostgres() to configure
  // ProliferationDbContext. The ProliferationWorker polls this store at runtime.
  "ConnectionStrings": {
    "ProliferationDb": "Host=localhost;Port=5432;Database=muonroi_proliferation;Username=admin;Password=admin"
  },
  // ProliferationOptions bound by AddMProliferationEngine().
  // BrainProvider selects the AI backend (ollama | openai | claude).
  // AI endpoints are only contacted when a generation actually runs.
  "Proliferation": {
    "BrainProvider": "ollama",
    "AiTimeoutSeconds": 60,
    "EnableSemanticDedup": false,
    "EnableInfraAwareBudget": false
  }
}
