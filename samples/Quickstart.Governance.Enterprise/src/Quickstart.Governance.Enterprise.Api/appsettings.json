{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // License configuration — bound into LicenseConfigs by AddMEnterpriseGovernance()
  // (which calls AddLicenseProtection internally). With no LicenseFilePath the
  // app verifies to Free tier; premium/enterprise features are denied.
  "LicenseConfigs": {
    // Offline = verify a local license/activation proof (no network calls).
    "Mode": "Offline",
    // Soft = log on license failure rather than throwing at the guard level.
    "FailMode": "Soft",
    "LicenseFilePath": null,
    // Keep enterprise enforcement off so the sample runs without a license.
    "EnableChain": false,
    "EnableAntiTampering": false,
    "EnableServerValidation": false,
    "FallbackToOnlineActivation": false,
    "Enterprise": {
      // Disable secure-by-default policy requirement for the unlicensed sample.
      "EnableSecureDefaults": false
    },
    "Compliance": {
      "Enabled": false
    }
  }
}
