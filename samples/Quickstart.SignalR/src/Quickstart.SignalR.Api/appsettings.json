{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // MultiTenantConfigs — read by AddSignalRWithTenant(). When Enabled is true,
  // TenantHubFilter is registered to scope hub invocations per tenant.
  "MultiTenantConfigs": {
    "Enabled": false
  }
}
