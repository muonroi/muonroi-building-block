{
  "Observability": {
    // Set to true to use OtelSetup.AddObservability (requires a Muonroi Premium license).
    // Leave false (default) to use the built-in minimal OpenTelemetry setup that runs without
    // any license and is sufficient for local development.
    "UseMuonroiSetup": false
  },

  // Bound by OpenTelemetryConfigs (section name "OpenTelemetry").
  // ServiceName   — label reported to your tracing backend.
  // OtlpEndpoint  — leave empty to skip OTLP export; point to Jaeger / Collector when ready.
  "OpenTelemetry": {
    "ServiceName": "Quickstart.Observability",
    "OtlpEndpoint": ""
  },

  // Serilog structured-logging configuration.
  // The optional Serilog:OpenTelemetry sub-section activates the OTLP log sink.
  // The optional Serilog:File sub-section writes JSON logs to disk.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
