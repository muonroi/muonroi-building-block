{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Named connection strings are read by MConnectionStringProvider as
  // "<name>:ConnectionString". The "default" key matches the connectionName used
  // by AddMuonroiDapperRls / TenantRlsDapper. Left as a placeholder — this sample
  // does not open a real connection.
  "ConnectionStrings": {
    "default:ConnectionString": "Host=localhost;Database=quickstart;Username=app;Password=app"
  },
  // Multi-tenant + Dapper RLS configuration.
  // EnableRowLevelSecurity=false (default) makes AddMuonroiDapperRls a zero-impact
  // no-op so the app runs without a database. Set it true (and apply the RLS DDL)
  // to activate engine-level tenant isolation.
  "MultiTenantConfigs": {
    "Enabled": true,
    "EnableRowLevelSecurity": false,
    // Bound to DapperRlsOptions when RLS is enabled.
    "DapperRls": {
      "Provider": "PostgreSql",
      "BypassRoleName": "app_rls_bypass",
      "StrictMode": false,
      "VerifyRlsObjectsOnStartup": true
    }
  }
}
