{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // License configuration — bound into LicenseConfigs (LicenseConfigs.SectionName)
  // by AddLicenseProtection(). With no LicenseFilePath the app verifies to Free tier.
  "LicenseConfigs": {
    // Offline = verify a local license/activation proof (no network).
    "Mode": "Offline",
    // Soft = log on license failure, do not throw at the guard level.
    "FailMode": "Soft",
    // No license file present -> Free tier (premium features denied).
    "LicenseFilePath": null,
    "EnableChain": false,
    "EnableAntiTampering": false
  }
}
