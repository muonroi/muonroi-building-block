{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Fallback connection string used by MappingTenantConnectionStringFactory when a
  // tenant has no explicit mapping below.
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=quickstart;Username=app;Password=app"
  },
  // Bound to MultiTenantOptions. Strategy drives TenantSchemaSelector:
  //   SharedSchema   = all tenants share "dbo"
  //   SeparateSchema = each tenant maps to its own sanitized schema name
  "MultiTenantConfigs": {
    "Enabled": true,
    "Strategy": "SeparateSchema"
  },
  // Bound to TenantConnectionStringsOptions — per-tenant connection-string map used by
  // MappingTenantConnectionStringFactory.
  "TenantConnectionStrings": {
    "ConnectionStrings": {
      "acme": "Host=acme-db;Database=acme;Username=app;Password=app",
      "globex": "Host=globex-db;Database=globex;Username=app;Password=app"
    }
  }
}
