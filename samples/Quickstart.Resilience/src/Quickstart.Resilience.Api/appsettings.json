    "BaseUrl": "https://api.open-meteo.com/v1"
  },
  // PaymentGateway base URL — used by PaymentService to simulate gateway calls.
  "PaymentGateway": {
    "BaseUrl": "https://payment-gateway.example.com"
  }
}
