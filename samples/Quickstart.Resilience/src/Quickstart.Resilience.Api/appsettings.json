{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // WeatherApi base URL — used by WeatherApiClient to simulate external HTTP calls.
  // Point to a real endpoint or leave as-is to trigger deliberate failures.
