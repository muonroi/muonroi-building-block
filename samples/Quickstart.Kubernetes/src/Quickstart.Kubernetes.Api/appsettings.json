{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Bound to KubernetesConfigs.
  //   ClusterType: K8S | K3S | Eks (defaults to K8S)
  //   ClusterEndpoint: API server URL (null = use in-cluster service account config)
  "KubernetesConfigs": {
    "ClusterType": "K8S",
    "ClusterEndpoint": "https://kubernetes.default.svc"
  }
}
