{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // JWT issuer/audience — bound into MTokenInfo (MTokenInfo.SectionName = "TokenConfigs")
  // and consumed by JwtService for token issuance and validation.
  "TokenConfigs": {
    "Issuer": "quickstart-auth",
    "Audience": "quickstart-clients",
    "UseRsa": true,
    "ExpiryMinutes": 60
  }
}
