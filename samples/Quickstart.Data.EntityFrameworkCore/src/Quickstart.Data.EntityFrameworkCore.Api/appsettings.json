{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // DatabaseConfigs is what AddDbContextConfigure<TDbContext, TPermission> binds in a
  // real service: DbType selects the IDbContextConfigurator and the matching connection
  // string is used. This sample uses the EF Core in-memory provider instead (see
  // Program.cs), so these values are illustrative placeholders only.
  "DatabaseConfigs": {
    "DbType": "Sqlite",
    "ConnectionStrings": {
      "SqliteConnectionString": "Data Source=quickstart.db",
      "PostgreSqlConnectionString": "Host=localhost;Database=quickstart;Username=app;Password=app",
      "SqlServerConnectionString": "Server=localhost;Database=quickstart;Trusted_Connection=True;TrustServerCertificate=True"
    }
  },
  // Multi-tenant options bound by AddDbContextConfigure (Strategy drives TenantSchemaSelector).
  "MultiTenantConfigs": {
    "Enabled": true,
    "Strategy": "SharedSchema"
  }
}
