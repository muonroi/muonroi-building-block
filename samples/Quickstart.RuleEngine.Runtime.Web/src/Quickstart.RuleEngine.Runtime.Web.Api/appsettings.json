{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // File-backed ruleset store — bound by AddRuleEngineStore() (RuleStoreConfigs).
  // No database required: rulesets are persisted as files under RootPath.
  "RuleStore": {
    "RootPath": "rulesets",
    "UseContentRoot": true,
    "EnableRuntimeCache": true,
    "RuntimeCacheMinutes": 10
  },
  // Maker-checker + lifecycle options bound by RuleControlPlaneOptions.
  "RuleControlPlane": {
    "RequireApproval": false,
    "EnableCanary": false
  },
  // Rule tracing options bound by AddRuleEngineTracing (RuleTracingOptions).
  "RuleTracing": {
    "Enabled": true
  }
}
