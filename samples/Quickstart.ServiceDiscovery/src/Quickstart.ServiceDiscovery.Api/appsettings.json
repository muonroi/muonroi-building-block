{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Bound to ConsulConfigs by AddServiceDiscovery.
  //   Enable / UseDiscovery: master switches for the integration.
  //   ServiceName + ConsulAddress: required to register IConsulClient (non-Development).
  //   ServiceAddress / ServicePort: how this instance is advertised in Consul
  //     (left blank → derived from the server's listening address at startup).
  "ConsulConfigs": {
    "Enable": true,
    "UseDiscovery": true,
    "ServiceName": "quickstart-service",
    "ConsulAddress": "http://localhost:8500",
    "ServiceAddress": "",
    "ServicePort": 0,
    "ServiceMetadata": {
      "version": "1.0.0"
    }
  }
}
