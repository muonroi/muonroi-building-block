<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>muonroi-rule</ToolCommandName>
    <PackageId>Muonroi.RuleGen</PackageId>
    <Version>2.0.0</Version>
    <Authors>Muon Roi</Authors>
    <Description>Code-first rule extraction CLI for Muonroi rule engine.</Description>
  </PropertyGroup>
  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Muonroi.RuleEngine.Abstractions\Muonroi.RuleEngine.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Muonroi.RuleEngine.Proliferation\Muonroi.RuleEngine.Proliferation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="8.0.*" />
    <PackageReference Include="Scriban" Version="6.6.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.*" />
  </ItemGroup>
</Project>
