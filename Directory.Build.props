<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <NoWarn>$(NoWarn);NU1605</NoWarn>

    <!-- Ship gate (Rule 2a): the whole solution must build with zero warnings and zero errors.
         Every compiler/analyzer/MSBuild warning is promoted to an error. The two accepted,
         non-actionable warnings stay as warnings via WarningsNotAsErrors:
           - RS1038: in-repo Roslyn analyzers bundle their code-fix providers (require a
                     Microsoft.CodeAnalysis.Workspaces reference). Also fully suppressed for
                     IsRoslynComponent projects in Directory.Build.targets (eval-order correct).
           - xUnit1030: ConfigureAwait advisory for test methods (also NoWarn'd for test projects). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS1038;xUnit1030</WarningsNotAsErrors>
    <EnforceExtendedAnalyzerRules Condition="'$(MSBuildProjectName)' == 'Muonroi.RuleEngine.SourceGenerators'">true</EnforceExtendedAnalyzerRules>
    <!-- OSS default - commercial packages override this in their .csproj -->
    <PackageLicenseFile>LICENSE-APACHE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/muonroi/MuonroiBuildingBlock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/muonroi/MuonroiBuildingBlock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Le Anh Phi</Authors>
    <Company>Muonroi Framework</Company>
    <Copyright>Copyright (c) 2024-2026 Le Anh Phi</Copyright>

    <!-- NuGet publish quality -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>muonroi;dotnet;framework;building-block;microservices;multi-tenancy;rule-engine</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Exclude from code coverage for specific projects -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Muonroi.Rules' or '$(MSBuildProjectName)' == 'Muonroi.BuildingBlock.IntegrationTests' or '$(MSBuildProjectName)' == 'RuleSourceGen.Api'">
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

  <PropertyGroup>
    <IsMuonroiTestProject Condition="'$(IsTestProject)' == 'true'">true</IsMuonroiTestProject>
    <IsMuonroiTestProject Condition="'$(IsMuonroiTestProject)' == '' and $([System.String]::Copy('$(MSBuildProjectName)').Contains('.Tests'))">true</IsMuonroiTestProject>
    <IsMuonroiTestProject Condition="'$(IsMuonroiTestProject)' == '' and $([System.String]::Copy('$(MSBuildProjectName)').Contains('.Test'))">true</IsMuonroiTestProject>
    <IsMuonroiTestProject Condition="'$(IsMuonroiTestProject)' == '' and $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\tests\'))">true</IsMuonroiTestProject>
    <IsMuonroiTestProject Condition="'$(IsMuonroiTestProject)' == '' and $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/tests/'))">true</IsMuonroiTestProject>
    <IsMuonroiTestProject Condition="'$(IsMuonroiTestProject)' == ''">false</IsMuonroiTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsMuonroiTestProject)' == 'true'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CS1591: test code is not part of the public API surface, no XML docs required.
         xUnit1030: xUnit's ConfigureAwait guidance is advisory for test methods; not a ship defect. -->
    <NoWarn>$(NoWarn);CS1591;xUnit1030</NoWarn>
  </PropertyGroup>

  <!-- Common Test Dependencies — versions managed by Directory.Packages.props (CPM) -->
  <ItemGroup Condition="'$(IsMuonroiTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsCommercialPackage)' != 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE-APACHE"
          Pack="true" PackagePath="\"
          />
    <!-- Per-package README: if the package directory ships its own README.md, that one is packed
         (wired via the <None Update> in Directory.Build.targets, which runs after the SDK default
         item globs exist). The repo-root README is only packed as a fallback when a package has no
         README of its own — keeping the two mutually exclusive so NuGet never sees a duplicate
         README.md at PackagePath '\'. -->
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true" PackagePath="\"
          Condition="!Exists('$(MSBuildProjectDirectory)/README.md') and Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png"
          Pack="true" PackagePath="\"
          Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsCommercialPackage)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE-COMMERCIAL"
          Pack="true" PackagePath="\"
          />
    <!-- Per-package README: if the package directory ships its own README.md, that one is packed
         (wired via the <None Update> in Directory.Build.targets, which runs after the SDK default
         item globs exist). The repo-root README is only packed as a fallback when a package has no
         README of its own — keeping the two mutually exclusive so NuGet never sees a duplicate
         README.md at PackagePath '\'. -->
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true" PackagePath="\"
          Condition="!Exists('$(MSBuildProjectDirectory)/README.md') and Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png"
          Pack="true" PackagePath="\"
          Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
  </ItemGroup>

  <!-- Package version: single source of truth — bump here to release all packages -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.15</VersionSuffix>
  </PropertyGroup>

  <!-- Version governance: TFM-conditional versions for framework-coupled packages -->
  <Import Project="build/Version.props" />

  <!-- NOTE: RS1038 suppression for IsRoslynComponent projects lives in Directory.Build.targets,
       not here. IsRoslynComponent is set in each analyzer .csproj body, which is evaluated AFTER
       this file is imported but BEFORE Directory.Build.targets — so the condition only resolves
       correctly there. (See Directory.Build.targets.) -->

  <!-- System-wide Muonroi.CodeStandards analyzer (MSTD0001/MSTD0002/MSTD0003). Excludes Roslyn-component
       projects (analyzers/source generators): they target netstandard2.0 and cannot reference
       Muonroi.Core.Abstractions (where MGuard/MException live), so the rules do not apply. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Muonroi.CodeStandards' and '$(IsRoslynComponent)' != 'true'">
    <ProjectReference Include="$(RepositoryRoot)src\Muonroi.CodeStandards\Muonroi.CodeStandards.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
